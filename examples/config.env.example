# Copy to .env (ignored by Git), edit locally, then run: set -a; source .env; set +a
# These variables are read by watch/generate_project.py, not by an automatic dotenv loader.
HEMORY_BUNDLE_ID=org.example.myhemory
# Empty leaves signing unconfigured. Select your own Team in Xcode, or set it locally here.
HEMORY_DEVELOPMENT_TEAM=
# Shell convenience only; pass this value using the relevant --data-dir / --data-root argument.
HEMORY_DATA_DIR="$HOME/Library/Application Support/HemoryLocal"
# No API key or paid provider is required for the local-only setup.
