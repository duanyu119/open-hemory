{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://extbrain.local/contracts/semantic-result-v1",
  "title": "ExtBrain derived conversation revision v1",
  "type": "object",
  "required": ["id", "title", "overview", "started_at", "ended_at", "status", "utterances", "topics", "chunks"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "overview": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pending", "transcribed", "ready", "needs_review"]},
    "boundary_status": {"type": "string"},
    "manual": {"type": "boolean"},
    "utterances": {"type": "array", "items": {"$ref": "#/$defs/utterance"}},
    "topics": {"type": "array", "items": {
      "type": "object", "required": ["id", "title", "utterance_ids", "key_points"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"},
        "utterance_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "key_points": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    }},
    "chunks": {"type": "array", "items": {"type": "object", "required": ["chunk_id", "started_at", "duration", "sha256"]}}
  },
  "$defs": {
    "source_span": {
      "description": "Original media timeline, integer milliseconds, half-open [start,end). Runtime validates end>start, media bounds, source ID and SHA.",
      "type": "object", "required": ["chunk_id", "sha256", "start_ms", "end_ms"],
      "properties": {
        "chunk_id": {"type": "string", "format": "uuid"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}
      }
    },
    "utterance": {
      "type": "object", "required": ["id", "text", "source_spans"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1},
        "source_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_span"}},
        "hidden": {"type": "boolean"}, "timing_quality": {"type": "string"}
      }
    },
    "claim": {
      "type": "object", "required": ["text", "evidence_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
